<Window x:Class="Arzenal.StoreManager.WPF.Views.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmation" Height="150" Width="350"
        Icon="pack://application:,,,/Ressources/Image/Warning.ico">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
            <TextBlock x:Name="MessageTextBlock" Text="Êtes-vous sûr de vouloir supprimer cette application ?" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ButtonStyle}" Content="Annuler" Height="20" Width="80" Margin="5" Command="{Binding NoCommand}"/>
                <Button Style="{StaticResource ButtonStyle}" Content="Supprimer" Height="20" Width="80" Margin="5" Command="{Binding YesCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
