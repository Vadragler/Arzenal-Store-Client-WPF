<UserControl x:Class="Arzenal.StoreManager.WPF.Views.AppInfo.Controls.AppVisibilityField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Arzenal.StoreManager.WPF.Views.AppInfo.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- TextBlock -->
            <RowDefinition Height="Auto"/>
            <!-- TextBox + Button -->
            <RowDefinition Height="Auto"/>
            <!-- Image -->
        </Grid.RowDefinitions>

        <!-- Section pour la visibilité de l'application -->
        <TextBlock Text="Visible:"
                   Style="{StaticResource ModernTextBlock}"
                   Margin="10,0,10,0"
                   Grid.Row="0"/>
        <CheckBox x:Name="AppIsVisibleCheckBox"
                  Style="{StaticResource ModernCheckBox}"
                  IsChecked="{Binding IsVisible}"
                  Margin="10,0,10,10"
                  Grid.Row="1"/>
    </Grid>
</UserControl>
