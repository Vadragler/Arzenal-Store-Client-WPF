<UserControl x:Class="Arzenal.StoreManager.WPF.Views.AppInfo.Controls.AppDescriptionField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Arzenal.StoreManager.WPF.Views.AppInfo.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- TextBlock -->
            <RowDefinition Height="Auto"/>
            <!-- TextBox + Button -->
            <RowDefinition Height="Auto"/>
            <!-- Image -->
        </Grid.RowDefinitions>

        <!-- Section pour la description de l'application -->
        <TextBlock Text="Description:"
                   Style="{StaticResource ModernTextBlock}"
                   Margin="10,0,10,0"
                   Grid.Row="0"/>
        <TextBox x:Name="AppDescriptionTextBox"
                 Text="{Binding AppDescription}"
                 Style="{StaticResource ModernTextBox}"
                 Margin="10,5,10,10"
                 Height="100" 
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Grid.Row="1"/>
    </Grid>
</UserControl>
