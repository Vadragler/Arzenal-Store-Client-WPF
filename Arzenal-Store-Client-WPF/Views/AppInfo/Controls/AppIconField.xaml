<UserControl x:Class="Arzenal.StoreManager.WPF.Views.AppInfo.Controls.AppIconField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Arzenal.StoreManager.WPF.Views.AppInfo.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="400">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- TextBlock -->
            <RowDefinition Height="Auto"/>
            <!-- TextBox + Button -->
            <RowDefinition Height="Auto"/>
            <!-- Image -->
        </Grid.RowDefinitions>

        <!-- Label -->
        <TextBlock Text="Icône de l'application:"
                   Style="{StaticResource ModernTextBlock}"
                   Margin="10,10,10,0"
                   Grid.Row="0"/>

        <!-- TextBox + Button -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="AppIconPathTextBox"
                     Style="{StaticResource ModernTextBox}"
                     Text="{Binding AppIconPath}"
                     Grid.Column="0"
                     Margin="10,0,0,0"/>
            <Button Style="{StaticResource IconButtonStyle}"
                    Height="20"
                    Tag="{StaticResource UploadIcon}"
                    Grid.Column="1"
                    Margin="10,0,10,0"
                    Command="{Binding BrowseIconCommand}"/>
        </Grid>

        <!-- Image -->
        <Image x:Name="AppIconImage"
               Width="50"
               Height="50"
               Margin="20,5,0,5"
               HorizontalAlignment="Left"
               Source="{Binding AppIconPath}"
               Grid.Row="2"/>
    </Grid>
</UserControl>
