<UserControl x:Class="Arzenal.StoreManager.WPF.Views.AppInfo.Controls.AppNameField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Arzenal.StoreManager.WPF.Views.AppInfo.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- TextBlock -->
            <RowDefinition Height="Auto"/>
            <!-- TextBox + Button -->
            <RowDefinition Height="Auto"/>
            <!-- Image -->
        </Grid.RowDefinitions>
        <!-- Section pour le nom de l'application -->
        <TextBlock Text="Nom de l'application:"
                   Style="{StaticResource ModernTextBlock}"
                   Margin="10,10,10,0"
                   Grid.Row="0"/>
        <TextBox x:Name="AppNameTextBox"
                 Text="{Binding AppName}"
                 Style="{StaticResource ModernTextBox}"
                 Margin="10,5,10,10"
                 Grid.Row="1"/>
        <TextBlock Text="Ce nom est déjà utilisé"
                   Style="{StaticResource ModernTextBlock}"
                   Foreground="Red"
                   x:Name="WarningTextName"
                   Margin="10,0,10,10"
                   Visibility="Collapsed"
                   Grid.Row="2"/>

    </Grid>
</UserControl>
