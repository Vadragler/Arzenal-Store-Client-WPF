<UserControl x:Class="Arzenal.StoreManager.WPF.Views.AppInfo.Controls.GenericCollectionField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Arzenal.StoreManager.ViewModels.AppFormViewModel"
             x:Name="Root">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding SectionTitle}"
                   Style="{StaticResource ModernTextBlock}"
                   Margin="10,0,10,0"/>
        <ComboBox ItemsSource="{Binding Items}"
                  SelectedItem="{Binding ChosenItem, Mode=TwoWay}"
                  Style="{StaticResource ModernComboBox}"
                  DisplayMemberPath="Name"
                  Margin="5" Height="30" Width="200"/>

        <ListBox ItemsSource="{Binding SelectedItems}"
                 Grid.Row="1"
                 Style="{StaticResource ModernListBox}"
                 Margin="5" Height="100">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        <Button Content="Parcourir"
                                Style="{StaticResource TagButtonStyle}"
                                Grid.Column="1"
                                Command="{Binding DataContext.BrowseFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding DataContext.IsOsSection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                />

                        <Button Content="Supprimer"
                                Style="{StaticResource TagButtonStyle}"
                                Grid.Column="2"
                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>