<Window x:Class="Arzenal_Store_Client_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Arzenal_Store_Client_WPF.Settings"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:services="clr-namespace:Arzenal_Store_Client_WPF.Services" 
        xmlns:local1="clr-namespace:Arzenal_Store_Client_WPF.Services" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        Title="App Store" 
        MinHeight="430" 
        MinWidth="790" 
        Width="Auto" 
        Height="780"
        Margin="10,10,10,10">


    <Window.Resources>
        <local:MaxHeightConverter x:Key="MaxHeightConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="40" />
        </Grid.ColumnDefinitions>

        <!-- Bouton pour ajouter une application -->
        <Button Name="AddAppButton" Content="Add App" 
            Style="{StaticResource IconButtonStyle}" 
            Tag="{StaticResource AddIcon}" 
            Height="30" 
            Width="30" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top"
            Margin="0,0,10,10" 
            Grid.Column="0"
            Click="AddApp_Click"/>

        <!-- Encapsuler la ListBox dans un ScrollViewer -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ListBox x:Name="AppList"
             ItemsSource="{Binding Apps}"
             ItemTemplate="{StaticResource AppTemplate}"
             BorderThickness="0"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top"
             Margin="0,20,0,1"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             SelectionChanged="AppList_SelectionChanged"/>
        </ScrollViewer>


        



        <!-- Bouton pour les paramètres -->
        <Button Name="SettingButton" 
            Style="{StaticResource IconButtonStyle}" 
            Tag="{StaticResource SettingIcon}" 
            Height="30" 
            Width="30" 
            HorizontalAlignment="Right" 
            VerticalAlignment="Top"
            Margin="0,0,10,10"     
            Grid.Row="0"
            Grid.Column="3"
            Click="SettingButton_Click"/>

        <!-- Icon deconnecté plus bouton reconnection -->
        <Grid Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Name="ListNonConnecter" Orientation="Vertical" 
                    Visibility="Visible">
                <Image Source="{StaticResource LostIcon}" Width="100" Height="100" 
                   HorizontalAlignment="Center"/>
                <Button Content="Réessayer"
                    Width="100" Height="30" Margin="10" 
                    HorizontalAlignment="Center"
                        Click="ReconnectButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Description des applications -->
        <ContentControl Name="DetailsView" 
                    Content="{Binding SelectedApp}" 
                    ContentTemplate="{StaticResource AppDetailsTemplate}" 
                    Visibility="Collapsed" 
                    Grid.Row="1" 
                    Grid.Column="1"/>
    </Grid>




</Window>
