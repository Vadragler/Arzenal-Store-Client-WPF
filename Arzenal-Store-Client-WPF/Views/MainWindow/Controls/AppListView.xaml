<UserControl x:Class="Arzenal.StoreManager.WPF.Views.MainWindow.Controls.AppListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ListBox ItemsSource="{Binding Apps}"
                 ItemTemplate="{StaticResource AppTemplate}"
                 BorderThickness="0"
                 Margin="0,20,0,1"
                 SelectedItem="{Binding SelectedApp, Mode=TwoWay}" />
    </ScrollViewer>
</UserControl>


