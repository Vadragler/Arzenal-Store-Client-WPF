<UserControl x:Class="Arzenal.StoreManager.WPF.Views.MainWindow.Controls.NotConnectedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="300">

    <!-- Icon deconnecté plus bouton reconnection -->
    <Grid Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Name="ListNonConnecter" Orientation="Vertical" 
                 Visibility="Visible">
            <Image Source="{StaticResource LostIcon}" Width="100" Height="100" 
                HorizontalAlignment="Center"/>
            <Button Content="Connexion"
                 Width="100" Height="30" Margin="10" 
                 HorizontalAlignment="Center"
                         Command="{Binding ReconnectCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
