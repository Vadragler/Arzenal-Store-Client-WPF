<UserControl x:Class="Arzenal.StoreManager.WPF.Views.MainWindow.Controls.AppDetailsView"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ContentControl Name="DetailsView"
                 Content="{Binding SelectedApp}"
                 ContentTemplate="{StaticResource AppDetailsTemplate}"
                 Visibility="{Binding SelectedApp, Converter={StaticResource NullToVisibilityConverter}}"
                 Grid.Row="1"
                 Grid.Column="1"/>
</UserControl>
