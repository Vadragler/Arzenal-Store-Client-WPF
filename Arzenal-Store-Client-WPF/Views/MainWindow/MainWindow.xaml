<Window x:Class="Arzenal.StoreManager.WPF.Views.MainWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Arzenal.StoreManager.WPF.Views.MainWindow.Controls" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:conv="clr-namespace:Arzenal.StoreManager.WPF.Converters"
        xmlns:helpers="clr-namespace:Arzenal.StoreManager.Core.Services.Helpers;assembly=Arzenal.StoreManager.Core"

        Title="App Store"
        MinHeight="430"
        MinWidth="790"
        Height="780"
        Width="Auto">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barre d'action (haut) -->
        <DockPanel Grid.Row="0" LastChildFill="False">
            <Button Content="Add App"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="{StaticResource AddIcon}"
                    Height="30" Width="30"
                    Margin="0,0,10,0"
                    DockPanel.Dock="Left"
                    Command="{Binding AddAppCommand}" />

            <Button Content="Reconnexion"  Width="150" Height="40" Margin="5" Command="{Binding ReconnectCommand}"/>

            <Button Content="Settings"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="{StaticResource SettingIcon}"
                    Height="30" Width="30"
                    DockPanel.Dock="Right"
                    Command="{Binding OpenSettingsCommand}" />
        </DockPanel>

        <!-- Contenu principal -->
        <Grid Grid.Row="1">
            <!-- Liste d'applications -->
            <local:AppListView 
        Visibility="{Binding SelectedApp, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Collapsed}" />

            <!-- Vue des détails -->
            <ContentControl Content="{Binding SelectedApp}"
                    ContentTemplate="{StaticResource AppDetailsTemplate}"
                    Visibility="{Binding SelectedApp, Converter={StaticResource NullToVisibilityConverter}}" />

            <!-- État "Non connecté" -->
            <local:NotConnectedView 
        Visibility="{Binding IsConnected, Source={x:Static helpers:AppSessionState.Instance}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"
        Panel.ZIndex="100" />
        </Grid>

    </Grid>
</Window>
