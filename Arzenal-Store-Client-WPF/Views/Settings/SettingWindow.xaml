<Window x:Class="Arzenal.StoreManager.WPF.Views.Settings.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Arzenal.StoreManager.WPF.Views.Settings.Controls"
        Title="Paramètres" Height="450" Width="800">

    <Grid>
    <!-- Menu -->
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding IsMenuSettingsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
        <Button Content="Paramétrer OS" Command="{Binding ShowOSSettingCommand}" Style="{StaticResource MenuButtonStyle}" Width="150" Height="40" Margin="5"/>
        <Button Content="Paramétrer Langue" Command="{Binding ShowLanguageSettingsCommand}" Style="{StaticResource MenuButtonStyle}" Width="150" Height="40" Margin="5"/>
        <Button Content="Paramétrer Tag" Command="{Binding ShowTagSettingCommand}" Style="{StaticResource MenuButtonStyle}" Width="150" Height="40" Margin="5"/>
        <Button Content="Paramétrer Catégorie" Command="{Binding ShowCategorieSettingCommand}" Style="{StaticResource MenuButtonStyle}" Width="150" Height="40" Margin="5"/>
        
        </StackPanel>

    <!-- Panel paramétrage -->
    <views:SettingPanel HorizontalAlignment="Center" 
                       
                        VerticalAlignment="Center"
                        Visibility="{Binding IsMenuSettingsVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"/>
</Grid>

</Window>
