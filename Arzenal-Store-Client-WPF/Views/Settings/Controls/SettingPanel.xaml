<UserControl x:Class="Arzenal.StoreManager.WPF.Views.Settings.Controls.SettingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="400" Width="500">

    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20">

        <!-- Bouton Retour -->
        <Button Content="Retour"
            Command="{Binding BackCommand}"
            Style="{StaticResource MenuButtonStyle}"
            Width="100" Margin="0,0,0,10"/>

        <TextBlock Text="{Binding CurrentType}" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" HorizontalAlignment="Center"/>

        <ListBox ItemsSource="{Binding CurrentCollection}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 Height="150"
                 Margin="0,0,0,10"
                 >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Width="200"/>
                        <Button Content="Supprimer"
                                Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource MenuButtonStyle}"
                                Width="75" Margin="5,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
             Width="200"
             Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Content="Ajouter / Modifier"
                Command="{Binding AddOrUpdateCommand}"
                Style="{StaticResource MenuButtonStyle}"
                Width="120" Margin="5"/>
            <Button Content="Annuler"
                Command="{Binding CancelCommand}"
                Style="{StaticResource MenuButtonStyle}"
                Width="80" Margin="5"/>
        </StackPanel>
    </StackPanel>

</UserControl>
