<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="AppTemplate">
        <Border Style="{StaticResource AppBorderStyle}">
            <Grid Height="120">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Image -->
                <Image x:Name="AppIconImage" 
                   Source="{Binding Icon}" 
                   Width="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" 
                   Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                   Margin="5"/>

                <!-- Informations sur l'application -->
                <StackPanel Grid.Column="1" Width="Auto">
                    <TextBlock Text="{Binding App.Name}" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryBrush}" 
                           Margin="10,0,0,5" 
                           FontSize="17"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tags:" 
                               Foreground="Gray" 
                               FontStyle="Italic" 
                               Margin="10,0,10,5"/>
                        <ItemsControl ItemsSource="{Binding App.Tags}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="Gray"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Text="{Binding App.Category}" 
                           Foreground="DarkSlateGray" 
                           Margin="10,0,10,0"/>

                    <StackPanel Orientation="Horizontal" Margin="10,5,0,0">
                        <TextBlock Text="{Binding App.ReleaseDate, StringFormat=Date de publication: {0:dd/MM/yyyy}}" 
                               Foreground="Gray" 
                               Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding App.LastUpdated, StringFormat=Dernière mise à jour: {0:dd/MM/yyyy}}" 
                               Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>

                <!-- Version and Platform on the same line -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10">
                    <TextBlock Text="{Binding App.Version}" 
                           Foreground="Gray" 
                           Margin="0,0,10,0"/>
                    <TextBlock Text="Plateforme : " 
                           Foreground="Gray"/>
                    <ItemsControl ItemsSource="{Binding App.OperatingSystems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="Gray"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Boutons -->
                <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10">
                    <!-- Button for Remove - Command Binding -->
                    <Button Style="{StaticResource IconButtonStyle}" 
                        HorizontalAlignment="Right" 
                        Margin="10" 
                        Tag="{StaticResource DeleteIcon}" 
                        Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
                    <!-- Pass the current AppModel as parameter -->

                    <!-- Button for Modify - Command Binding -->
                    <Button Style="{StaticResource IconButtonStyle}" 
                        HorizontalAlignment="Right" 
                        Margin="10" 
                        Tag="{StaticResource EditIcon}" 
                        Command="{Binding DataContext.ModifyAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
                    <!-- Pass the current AppModel as parameter -->
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>