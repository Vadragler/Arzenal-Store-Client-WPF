<Application x:Class="Magasin_PC.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Magasin_PC"
             StartupUri="Fenêtre/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Ressource/Icons/Icons.xaml"/>
                <ResourceDictionary Source="Ressource/Boutons/Boutons.xaml"/>
                <ResourceDictionary Source="Ressource/CheckBox/CheckBox.xaml"/>
                <ResourceDictionary Source="Ressource/ListBox/ListBox.xaml"/>
                <ResourceDictionary Source="Ressource/Couleur/Couleur.xaml"/>
                <ResourceDictionary Source="Ressource/Template/Template.xaml"/>
                <ResourceDictionary Source="Ressource/ComboBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="{x:Type FrameworkElement}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
