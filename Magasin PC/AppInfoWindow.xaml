<Window x:Class="Magasin_PC.AppInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Magasin_PC"
        mc:Ignorable="d"
        Title="AppInfoWindow" Height="450" Width="800" MinWidth="350" MinHeight="400">
    <Grid>
        <StackPanel>
       <!-- <StackPanel Margin="10">-->
            <TextBlock Text="Icone de l'application:" Margin="10,0,10,0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- Colonne qui s'étire pour le TextBox -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Colonne pour le Button avec largeur automatique -->
                    </Grid.ColumnDefinitions>
                    
                    <!--<StackPanel Orientation="Horizontal">-->
                    <TextBox x:Name="AppIconPathTextBox" Grid.Column="0" Margin="10,0,0,0" Height="20"/>
                <Button Content="Browse..." Height="20" Grid.Column="1"  Click="BrowseIcon_Click" Margin="0,0,10,0" />
                        
                    <!--</StackPanel>-->
                </Grid>
            <Image x:Name="AppIconImage" Width="50" Grid.Column="2" Height="50" Margin="20,5,0,5" HorizontalAlignment="Left"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- Colonne qui s'étire pour le TextBox -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Colonne pour le Button avec largeur automatique -->
                    </Grid.ColumnDefinitions>
                <TextBlock Text="Nom de l'application:" Margin="10,0,10,0"/>
                    <TextBlock Text="Ce nom est déja utilisé" Grid.Column="1" Margin="10,0,10,0" Foreground="Red" x:Name="WarningTextName"/>
                </Grid>
                <TextBox x:Name="AppNameTextBox" Margin="10,5,10,10"/>

            <TextBlock Text="Version:" Margin="10,0,10,0"/>
            <TextBox x:Name="AppVersionTextBox" Margin="10,5,10,10"/>

            <TextBlock Text="Description:" Margin="10,0,10,0"/>
            <TextBox x:Name="AppDescriptionTextBox" Margin="10,5,10,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- Colonne qui s'étire pour le TextBox -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Colonne pour le Button avec largeur automatique -->
                    </Grid.ColumnDefinitions>

                <TextBlock Text="Chemin d'accès:" Margin="10,0,10,0"/>
                    <TextBlock Text="Ce chemin d'accès est déja utilisé" Grid.Column="1" Margin="10,0,10,0" Foreground="Red" x:Name="WarningTextFilePath"/>
                </Grid>
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <!-- Colonne qui s'étire pour le TextBox -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Colonne pour le Button avec largeur automatique -->
                </Grid.ColumnDefinitions>

                <!-- TextBox qui prend toute la largeur -->
                    <TextBox x:Name="AppFilePathBox" Margin="10,5,0,10" 
             Grid.Column="0" HorizontalAlignment="Stretch"/>

                <!-- Button avec largeur fixe -->
                <Button x:Name="AppFilePathButton" Margin="0,5,10,10" 
            Height="20" Width="20" Grid.Column="1" Content="..." Click="ModifyFilePath_Click"/>
            </Grid>

            <TextBlock Text="Visible:" Margin="10,0,10,0"/>
            <CheckBox x:Name="AppIsVisibleCheckBox" IsChecked="False" Margin="10,0,10,0"/>
        
        <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Annuler" Margin="0,0,10,0" Width="100" Height="30" Click="CancelButton_Click"/>
        <Button Content="Enregistrer" Margin=" 0,0,10,0"  Width="100" Height="30" Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
