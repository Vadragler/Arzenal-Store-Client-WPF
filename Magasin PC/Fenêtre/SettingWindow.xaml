<Window x:Class="Magasin_PC.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SettingWindow" Height="450" Width="800">

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF6200EE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFBB86FC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Button Name="BackButton" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Left" Content="Ajouter" Click="Back_Click" ToolTip="Retour" Margin="10" Style="{StaticResource IconButtonStyle}" Tag="{StaticResource BackIcon}"/>
        <!-- Menu de sélection pour choisir OS, Langue ou Tag -->
        <StackPanel Name="MenuSettingsPanel" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
            <Button Content="Paramétrer OS" Click="ShowOSSettings" Width="150" Height="40" Style="{StaticResource MenuButtonStyle}" Margin="5"/>
            <Button Content="Paramétrer Langue" Click="ShowLanguageSettings" Width="150" Height="40" Style="{StaticResource MenuButtonStyle}" Margin="5"/>
            <Button Content="Paramétrer Tag" Click="ShowTagSettings" Width="150" Height="40" Style="{StaticResource MenuButtonStyle}" Margin="5"/>
            <Button Content="Paramétrer Catégorie" Click="ShowCategorieSettings" Width="150" Height="40" Style="{StaticResource MenuButtonStyle}" Margin="5"/>
        </StackPanel>

        <!-- Panel commun pour les paramètres OS, Langue ou Tag -->
        <StackPanel Name="SettingPanel" Visibility="Collapsed" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
            <!-- Titre -->
            <TextBlock Name="SettingsTitle" Text="Sélectionnez une option" FontWeight="Bold" Margin="10" />

            <!-- Liste dynamique pour afficher OS, Langue ou Tag -->
            <ListBox Name="SettingsList" SelectionChanged="SettingsList_SelectionChanged" Height="100">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Width="200"/>
                            <Button Content="Supprimer" Click="DeleteItem_Click" DataContext="{Binding}" Style="{StaticResource IconButtonStyle}" ToolTip="Supprimer l'élément" Margin="5,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Zone de texte pour ajouter ou modifier -->
            <TextBox Name="SettingsTextBox" Width="200" Margin="10" />

            <!-- Bouton pour ajouter ou modifier -->
            <Button Name="AddOrUpdateButton" Content="Ajouter" Click="AddOrUpdateItem_Click" Style="{StaticResource IconButtonStyle}" Tag="{StaticResource AddIcon}" Width="100" Margin="5" />
            <Button Name="CancelButton" Content="Ajouter" Click="CancelButton_Click" Style="{StaticResource IconButtonStyle}" Width="100" Margin="5" />
        </StackPanel>
    </Grid>
</Window>
