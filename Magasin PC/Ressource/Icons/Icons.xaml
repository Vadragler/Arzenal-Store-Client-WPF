                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="IconImage" Storyboard.TargetProperty="(GeometryDrawing.Brush).(Image.Source).(DrawingImage.Drawing).(GeometryDrawing.Pen).(Pen.Brush).(SolidColorBrush.Color)" To="#FFBB86FC" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="IconImage" Storyboard.TargetProperty="(GeometryDrawing.Brush).(Image.Source).(DrawingImage.Drawing).(GeometryDrawing.Pen).(Pen.Brush).(SolidColorBrush.Color)" To="#FF3700B3" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

