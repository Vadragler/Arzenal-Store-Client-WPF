        <!--Template liste de la fenêtre MainWindow-->
        <DataTemplate x:Key="AppTemplate">
            <Border Style="{StaticResource AppBorderStyle}">
                <Grid Height="120">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Pour l'image -->
                        <ColumnDefinition Width="*"/>
                        <!-- Pour les informations sur l'application -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Pour les boutons -->
                    </Grid.ColumnDefinitions>

                    <!-- Image -->
                    <Image x:Name="AppIconImage" 
                   Source="{Binding Icone}" 
                   Width="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" 
                   Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                   Margin="5"/>

                    <!-- Informations sur l'application -->
                    <StackPanel Grid.Column="1" Width="Auto">
                        <TextBlock Text="{Binding Name}" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryBrush}" 
                           Margin="10,0,0,5" 
                           FontSize="17"/>

                        <!-- Tags and Category on a single line -->
                        
                        <TextBlock Text="{Binding Tag, StringFormat=Tags: {0}}" 
                                   Foreground="Gray" 
                                   FontStyle="Italic" 
                                   Margin="10,0,10,5"/>
                        <TextBlock Text="{Binding Category, StringFormat=Catégorie: {0}}" 
                                   Foreground="DarkSlateGray" 
                                   Margin="10,0,10,0"/>
                        

                        <!-- Release Date and Last Update on a single line -->
                        <StackPanel Orientation="Horizontal" Margin="10,5,0,0">
                            <TextBlock Text="{Binding ReleaseDate, StringFormat=Date de publication: {0:dd/MM/yyyy}}" 
                               Foreground="Gray" 
                               Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding LastUpdated, StringFormat=Dernière mise à jour: {0:dd/MM/yyyy}}" 
                               Foreground="Gray"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Version and Platform on the same line -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10">
                        <TextBlock Text="{Binding Version}" 
                           Foreground="Gray" 
                           Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Platform, StringFormat=Plateforme: {0}}" 
                           Foreground="Gray"/>
                    </StackPanel>

                    <!-- Boutons -->
                    <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10">
                        <Button Style="{StaticResource IconButtonStyle}" 
                        HorizontalAlignment="Right" 
                        Margin="10" 
                        Tag="{StaticResource DeleteIcon}" 
                        Click="RemoveApp_Click" 
                        DataContext="{Binding}"/>
                        <Button Style="{StaticResource IconButtonStyle}" 
                        HorizontalAlignment="Right" 
                        Margin="10" 
                        Tag="{StaticResource EditIcon}" 
                        Click="ModifyApp_Click" 
                        DataContext="{Binding}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>


        <!--Template description de la fenêtre MainWindow-->
        <DataTemplate x:Key="AppDetailsTemplate">
            <Grid Margin="10,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- En-tête avec le bouton retour, le nom de l'application et les boutons -->
                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Bouton Retour -->
                    <Button Style="{StaticResource IconButtonStyle}" 
                    Tag="{StaticResource BackIcon}" 
                    Grid.Column="0" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" 
                    Margin="0,0,10,0" 
                    Click="BackToList_Click"/>

                    <!-- Nom de l'application -->
                    <TextBlock Text="{Binding Name}" 
                       FontWeight="Bold" 
                       FontSize="25" 
                       Foreground="{StaticResource PrimaryBrush}" 
                       Margin="10" 
                       VerticalAlignment="Center" 
                       Grid.Column="1"/>

                    <!-- Boutons Modifier et Supprimer -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}" 
                        Tag="{StaticResource EditIcon}" 
                        Margin="5" 
                        Click="ModifyApp_Click" 
                        DataContext="{Binding}"/>
                        <Button Style="{StaticResource IconButtonStyle}" 
                        Tag="{StaticResource DeleteIcon}" 
                        Margin="5" 
                        Click="RemoveApp_Click" 
                        DataContext="{Binding}"/>
                    </StackPanel>
                </Grid>

                <!-- Image de l'application -->
                <Image Grid.Row="1" Grid.Column="0" 
               Source="{Binding Icone}" 
               Width="150" 
               Height="150" 
               Margin="10" 
               HorizontalAlignment="Left" 
               VerticalAlignment="Top"/>

                <!-- Détails de l'application -->
                <Grid Grid.Row="1" Grid.Column="1" Margin="20,10,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="20,10,10,10">

                        <!-- Section Version et Visibilité -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                                <TextBlock Text="Version:" Style="{StaticResource ModernTextBlock}" FontWeight="Bold" Foreground="Black" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Version}" Foreground="Gray" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Visible:" FontWeight="Bold" Style="{StaticResource ModernTextBlock}" Foreground="Black" Margin="0,0,0,5"/>
                                <CheckBox IsChecked="{Binding IsVisible}" IsEnabled="False" Style="{StaticResource ModernCheckBox}" Margin="0,0,10,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Section Catégorie -->
                        <TextBlock Text="Catégorie:" Style="{StaticResource ModernTextBlock}"  FontWeight="Bold" Foreground="Black" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding Category}" Foreground="Gray" Margin="0,0,0,10"/>

                        <!-- Section Tags -->
                        <TextBlock Text="Tags:" Style="{StaticResource ModernTextBlock}"  FontWeight="Bold" Foreground="Black" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding Tag, StringFormat={}{0}}" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"/>

                        <!-- Section Plateformes -->
                        <TextBlock Text="Plateformes:" Style="{StaticResource ModernTextBlock}"  FontWeight="Bold" Foreground="Black" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding Platform, StringFormat={}{0}}" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"/>

                        <!-- Section Conditions requises -->
                        <TextBlock Text="Conditions requises:" Style="{StaticResource ModernTextBlock}"  FontWeight="Bold" Foreground="Black" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding Requirements}" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"/>

                        <!-- Section Taille de l'application -->
                        <TextBlock Text="Taille de l'application:" Style="{StaticResource ModernTextBlock}"  FontWeight="Bold" Foreground="Black" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding AppSize, StringFormat={}{0:N0} octets}" Foreground="Gray" Margin="0,0,0,10"/>

                        <!-- Section Langues disponibles -->
                        <TextBlock Text="Langues disponibles:" Style="{StaticResource ModernTextBlock}"  FontWeight="Bold" Foreground="Black" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding Languages, StringFormat={}{0}}" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"/>

                        <!-- Section Dates de publication et de mise à jour -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                                <TextBlock Text="Date de publication:" Style="{StaticResource ModernTextBlock}"  FontWeight="Bold" Foreground="Black" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding ReleaseDate, StringFormat={}{0:dd/MM/yyyy}}" Foreground="Gray"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Dernière mise à jour:" Style="{StaticResource ModernTextBlock}"  FontWeight="Bold" Foreground="Black" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding LastUpdated, StringFormat={}{0:dd/MM/yyyy}}" Foreground="Gray"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Section Description -->
                        <TextBlock Text="Description:" FontWeight="Bold" Foreground="Black" Margin="0,0,0,5"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="100">
                            <TextBlock Text="{Binding Description}" Style="{StaticResource ModernTextBlock}"  TextWrapping="Wrap" Foreground="Black" Margin="0,0,0,5"/>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <DockPanel Margin="10">
        <Grid DockPanel.Dock="Top" Margin="0, 0, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <!-- Colonne pour le bouton Add App -->
                <ColumnDefinition Width="*" />
                <!-- Colonne pour la ListBox -->
                <ColumnDefinition Width="Auto" />
                <!-- Colonne pour le bouton Settings -->
                <ColumnDefinition Width="Auto" />
                <!-- Colonne pour la connexion SFTP -->
                <ColumnDefinition Width="Auto" />
                <!-- Colonne pour la connexion BDD -->
            </Grid.ColumnDefinitions>

            <!-- Bouton pour ajouter une application -->
            <Button Name="AddAppButton" Content="Add App" 
            Style="{StaticResource IconButtonStyle}" 
            Tag="{StaticResource AddIcon}" 
            Height="30" 
            Width="30" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" 
            Margin="0,0,10,10" 
            Grid.Column="0"
            Click="AddApp_Click"/>

            <!-- Liste des applications -->
            <ListBox x:Name="AppList"
            DockPanel.Dock="Top"
            ItemsSource="{Binding Apps}"
            ItemTemplate="{StaticResource AppTemplate}"
            BorderThickness="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}"
            Margin="10,20,20,1"
            Width="Auto"
            Grid.Column="1"
            MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectionChanged="AppList_SelectionChanged"/>

            <!-- Boutons de connexion SFTP et BDD -->
            <Button x:Name="ConnectionSftpStatusButton"
            Style="{StaticResource IconBddStyle}" 
            Tag="{StaticResource StorageConnexionIcon}"
            Height="30" 
            Width="30"
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" 
            Margin="0,0,10,10"
            Grid.Column="2"
            Click="ConnectionStorageButton_Click"/>

            <Button x:Name="ConnectionbddStatusButton"
            Style="{StaticResource IconBddStyle}" 
            Tag="{StaticResource DatabaseIcon}"
            Height="30" 
            Width="30"
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" 
            Margin="0,0,10,10"
            Grid.Column="3"
            Click="ConnectionStatusButton_Click"/>

            <Button Name="SettingButton" 
            Style="{StaticResource IconButtonStyle}" 
            Tag="{StaticResource SettingIcon}" 
            Height="30" 
            Width="30" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" 
            Margin="0,0,10,10" 
            Grid.Column="4"
            Click="SettingButton_Click"/>
        </Grid>

        <!-- Description des applications -->
        <ContentControl Name="DetailsView" 
        Content="{Binding SelectedApp}" 
        ContentTemplate="{StaticResource AppDetailsTemplate}" 
        Visibility="Collapsed"/>
    </DockPanel>

</Window>
